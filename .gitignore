# ============================================
# JobHunter .gitignore
# ============================================


# --------------------
# Secrets
# --------------------
.env
.env.*
!.env.example


# --------------------
# Python cache
# --------------------
__pycache__/
**/__pycache__/
*.pyc
*.pyo


# --------------------
# Terraform
# --------------------
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/*.zip

# Keep Terraform dependency lock file
!terraform/.terraform.lock.hcl


# --------------------
# Temporary AWS CLI test files
# --------------------
terraform/*key.json
terraform/*message.json
terraform/*result.json
terraform/*response.json

terraform/delete-key.json
terraform/key.json
terraform/message.json
terraform/telegram-message.json
terraform/telegram-result.json
terraform/payload.json


# --------------------
# Terraform-generated Lambda artifacts
# --------------------
terraform/jobhunter_lambda_zip


# --------------------
# Old / local Lambda folders
# --------------------

# Old deployment package
lambda_package/

# Development/source staging folder
# Actual deployed Lambda source is kept in the package folders below
lambda_app/


# --------------------
# Worker Lambda package
# --------------------

# Ignore everything in the deployment package by default.
# This prevents installed Python dependencies such as
# OpenAI, Pydantic, AnyIO, HTTPX, etc. from entering Git.
lambda_worker_package/*

# Keep our actual application source code
!lambda_worker_package/worker_function.py
!lambda_worker_package/matcher.py
!lambda_worker_package/ai_extractor.py
!lambda_worker_package/resume_extractor.py
!lambda_worker_package/skills.py
!lambda_worker_package/requirements.txt


# --------------------
# Personal / test data
# --------------------
resume.txt
resume.md
job.txt
job.md


# --------------------
# OS / Editor files
# --------------------
.DS_Store
Thumbs.db
.vscode/